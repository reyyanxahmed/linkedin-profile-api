# LinkedIn Profile API — environment variables.
# Copy this file to .env and fill in real values. .env is gitignored and NEVER committed.
# Every variable here is documented; values are empty or dummy.

# API key clients must send as X-API-Key. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# JSON array of sessions: [{"li_at":"...","jsessionid":"ajax:123..."}]
# jsessionid is stored WITHOUT surrounding quotes; the client adds them when building the cookie.
# If empty, the app still boots, /health is honest, and the public HTML fallback still works.
LI_SESSIONS=

# Redis connection. Use Upstash or Fly Redis in production.
REDIS_URL=redis://localhost:6379/0

# Cache TTL for profile responses, in seconds. 24h default. Acts as data-minimization window.
CACHE_TTL_SECONDS=86400

# curl_cffi TLS impersonation target. Matches Chrome's JA3/H2 fingerprint.
# Update when Chrome ships a new stable and curl_cffi adds the profile.
IMPERSONATE=chrome124

# Politeness / self-preservation. Random delay before each Voyager request.
MIN_DELAY_MS=800
MAX_DELAY_MS=2500

# Global concurrency cap on outbound LinkedIn requests.
MAX_CONCURRENCY=2

# Hard cooldown for a session after a 999/challenge/401, in seconds.
SESSION_COOLDOWN_SECONDS=900

# Optional outbound proxy. Unused in the demo deployment. Datacenter IPs get flagged harder.
HTTP_PROXY_URL=

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# OFFLINE MODE: serve from saved RSC fixtures instead of hitting LinkedIn.
# Set to true to run with zero network access (no LinkedIn account needed).
# Fixtures live in FIXTURE_DIR. Only profiles with a saved fixture will work.
# Profiles without a fixture return PROFILE_NOT_FOUND.
OFFLINE_MODE=false

# Directory containing RSC profile fixtures (profile_<slug>.json files).
# Used when OFFLINE_MODE=true. Defaults to tests/fixtures/rsc.
FIXTURE_DIR=tests/fixtures/rsc